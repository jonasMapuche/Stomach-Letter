<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Letter.Models"
             x:Class="Letter.Views.Templates.ReceiverBotItemTemplate">
    <ContentView.Content>
        <Grid
            ColumnDefinitions="Auto, *"
            Style="{StaticResource gridReceiverBotItemTemplate}">
            <Grid 
                Grid.Column="1">
                <BoxView
                    Style="{StaticResource boxReceiverBotItemTemplate}" />
                <Label 
                    x:DataType="models:Message"
                    Text="{Binding Text}"
                    Padding="12"
                    Style="{StaticResource lblReceiverBotItemTemplate}"/>
            </Grid>
        </Grid>
    </ContentView.Content>
</ContentView>
